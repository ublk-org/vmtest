#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# Boot the configured kernel under virtme-ng and run a test script inside.
#
# Usage (low-level):
#   ./run_vm <test-script-inside-vm> [args...]
#
# You normally invoke this via `./vmtest run <name>` instead.
#
# Boots the built kernel tree at KERNEL_DIR (from vmtest.conf or env), or
# the host's distribution kernel when KERNEL_DIR is unset/empty. The test script path is resolved on the host; the host fs is
# visible inside the VM via 9p so any absolute path under the repo works.
set -eu

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "$SELF_DIR/lib/common.sh"
vt_load_config

# `--shell` drops into an interactive root shell inside the guest instead
# of running a test. This must NOT go through virtme-ng's --exec/--script-sh
# path: in script mode the kernel console is a write-only chardev and the
# script's stdin is a non-tty virtio-serial port, so an interactive shell
# there gets no input and no job control. Interactive mode (no --exec) wires
# a bidirectional getty on the serial console instead. We reintroduce the
# env that --exec would have forwarded via a generated --shell wrapper below.
SHELL_MODE=
if [ "${1:-}" = "--shell" ]; then
	SHELL_MODE=1; shift
	TEST_CMD=
else
	if [ $# -lt 1 ]; then
		echo "usage: $0 <test-script|--shell> [args...]" >&2
		exit 2
	fi
	TEST_CMD="$1"; shift
fi

# Sanity checks before we shell out to vng.
VNG_BIN="${VMTEST_VNG:-vng}"
command -v "$VNG_BIN" >/dev/null \
	|| vt_die "'$VNG_BIN' not found (install virtme-ng or set VMTEST_VNG)"
# Kernel to boot. KERNEL_DIR set: that built tree. KERNEL_DIR empty: the
# distribution kernel the host is running — a bare `vng --run` boots
# /boot/vmlinuz-$(uname -r) with the host's /lib/modules, visible over 9p.
if [ -n "$KERNEL_DIR" ]; then
	[ -d "$KERNEL_DIR" ] \
		|| vt_die "KERNEL_DIR=$KERNEL_DIR does not exist (set it in vmtest.conf)"
	[ -f "$KERNEL_DIR/vmlinux" ] \
		|| vt_die "no vmlinux in $KERNEL_DIR — build the kernel first"
	RUN_ARGS=(--run "$KERNEL_DIR")
else
	HOST_KREL="$(uname -r)"
	[ -r "/boot/vmlinuz-$HOST_KREL" ] || [ -r "/lib/modules/$HOST_KREL/vmlinuz" ] \
		|| vt_die "KERNEL_DIR unset and no readable distro kernel for $HOST_KREL (/boot/vmlinuz-$HOST_KREL)"
	vt_log "KERNEL_DIR unset: booting the distribution kernel $HOST_KREL"
	RUN_ARGS=(--run)
fi

# Lazily create the two extra block devices the IOMMU tests want.
SDISK="$VMTEST_DATA_DIR/d1.img"
NDISK="$VMTEST_DATA_DIR/d2.img"
SDISK_SIZE="${VMTEST_SDISK_SIZE:-2G}"
NDISK_SIZE="${VMTEST_NDISK_SIZE:-2G}"
[ -f "$SDISK" ] || { vt_log "creating $SDISK ($SDISK_SIZE)"; truncate -s "$SDISK_SIZE" "$SDISK"; }
[ -f "$NDISK" ] || { vt_log "creating $NDISK ($NDISK_SIZE)"; truncate -s "$NDISK_SIZE" "$NDISK"; }

# VM sizing — resolved once here so the NUMA split below always matches
# what vng passes to QEMU's -m / -smp.
VM_CPUS="${VMTEST_CPUS:-16}"
VM_MEM="${VMTEST_MEM:-8G}"

# NUMA topology. VMTEST_NUMA_NODES > 1 emulates that many NUMA nodes,
# splitting memory and CPUs evenly across them (any remainder goes to the
# last node). QEMU requires the memory backends to sum exactly to -m, so
# everything is computed in MiB. Default (1) keeps today's flat topology.
NUMA_QEMU=
NUMA_NODES="${VMTEST_NUMA_NODES:-1}"
case "$NUMA_NODES" in
	''|*[!0-9]*|0) vt_die "VMTEST_NUMA_NODES must be a positive integer (got '$NUMA_NODES')" ;;
esac
if [ "$NUMA_NODES" -gt 1 ]; then
	case "$VM_MEM" in
		*[Gg]) MEM_NUM="${VM_MEM%[Gg]}"; MEM_SCALE=1024 ;;
		*[Mm]) MEM_NUM="${VM_MEM%[Mm]}"; MEM_SCALE=1 ;;
		*)     MEM_NUM="$VM_MEM";        MEM_SCALE=1 ;;  # bare = MiB (QEMU default)
	esac
	case "$MEM_NUM" in
		''|*[!0-9]*) vt_die "cannot split VMTEST_MEM='$VM_MEM' across NUMA nodes (use a plain integer with optional M/G suffix)" ;;
	esac
	MEM_MB=$(( MEM_NUM * MEM_SCALE ))
	[ "$VM_CPUS" -ge "$NUMA_NODES" ] \
		|| vt_die "VMTEST_NUMA_NODES=$NUMA_NODES needs at least that many CPUs (VMTEST_CPUS=$VM_CPUS)"
	MEM_PER=$(( MEM_MB / NUMA_NODES ))
	[ "$MEM_PER" -ge 1 ] || vt_die "VMTEST_MEM=$VM_MEM too small for $NUMA_NODES NUMA nodes"
	CPU_PER=$(( VM_CPUS / NUMA_NODES ))
	cpu_lo=0
	for (( node = 0; node < NUMA_NODES; node++ )); do
		if (( node == NUMA_NODES - 1 )); then
			node_mem=$(( MEM_MB - MEM_PER * node ))
			cpu_hi=$(( VM_CPUS - 1 ))
		else
			node_mem=$MEM_PER
			cpu_hi=$(( cpu_lo + CPU_PER - 1 ))
		fi
		NUMA_QEMU="$NUMA_QEMU -object memory-backend-ram,id=ram${node},size=${node_mem}M"
		NUMA_QEMU="$NUMA_QEMU -numa node,nodeid=${node},memdev=ram${node},cpus=${cpu_lo}-${cpu_hi}"
		cpu_lo=$(( cpu_hi + 1 ))
	done
	vt_log "NUMA: $NUMA_NODES nodes, ~${MEM_PER}M + ~${CPU_PER} cpus each (guest kernel needs CONFIG_NUMA=y)"
fi

QEMU_EXTRA="-machine q35,kernel-irqchip=split \
  -device intel-iommu,intremap=on,caching-mode=on,device-iotlb=on \
  -device virtio-scsi-pci,id=scsi_extra,num_queues=32 \
  -device scsi-hd,drive=extra_hd,bus=scsi_extra.0 \
  -drive if=none,id=extra_hd,file=${SDISK},format=raw \
  -drive file=${NDISK},format=raw,if=none,id=nvme_drv \
  -device nvme,drive=nvme_drv,serial=12345${NUMA_QEMU}${VMTEST_QEMU_EXTRA:+ $VMTEST_QEMU_EXTRA}"

KCMDLINE="intel_iommu=on systemd.mask=dev-zram0.device systemd.mask=systemd-zram-setup@zram0.service${VMTEST_KCMDLINE_EXTRA:+ $VMTEST_KCMDLINE_EXTRA}"

export TMPDIR="$VMTEST_TMPDIR"

# Forward config the test scripts may want.
#
# KERNEL_DIR and VMTEST_CONF matter for correctness: test scripts call
# vt_load_config again inside the guest, and without these in the guest
# environment they'd resolve KERNEL_DIR from the DEFAULT vmtest.conf --
# running another tree's selftests than the kernel we booted. Env beats
# conf in vt_load_config, so forwarding KERNEL_DIR pins the right tree.
#
# VMTEST_DIR is this checkout. A test registered under tests/ finds lib/
# relative to $0, but `vmtest run /path/to/script.sh` accepts a script
# living anywhere, and that one has no relative path back here -- so this
# is its only way to source lib/common.sh. Forwarded for both modes: the
# --exec line below passes $GUEST_ENV through, and the shell wrapper
# exports every pair in it.
GUEST_ENV="VMTEST_DATA_DIR=$VMTEST_DATA_DIR"
GUEST_ENV="$GUEST_ENV VMTEST_DIR=$SELF_DIR"
GUEST_ENV="$GUEST_ENV KERNEL_DIR=$KERNEL_DIR"
[ -n "${VMTEST_CONF:-}" ] && GUEST_ENV="$GUEST_ENV VMTEST_CONF=$VMTEST_CONF"
[ -n "${UBLKSRV_DIR:-}" ] && GUEST_ENV="$GUEST_ENV UBLKSRV_DIR=$UBLKSRV_DIR"
[ -n "${FIO_DIR:-}"     ] && GUEST_ENV="$GUEST_ENV FIO_DIR=$FIO_DIR"
[ -n "${RUBLK_DIR:-}"   ] && GUEST_ENV="$GUEST_ENV RUBLK_DIR=$RUBLK_DIR"
[ -n "${LIBURING_DIR:-}" ] && GUEST_ENV="$GUEST_ENV LIBURING_DIR=$LIBURING_DIR"
# Honoured by tests that want to hold the VM open after the test body
# completes (e.g., for post-mortem inspection via ssh). Tests should
# `sleep infinity` (or similar) when this is set.
[ -n "${VMTEST_HOLD:-}" ] && GUEST_ENV="$GUEST_ENV VMTEST_HOLD=$VMTEST_HOLD"
# In interactive shell mode, carry the host TERM through so readline,
# clear, and full-screen tools (vim, less) behave inside the guest.
if [ -n "$SHELL_MODE" ]; then
	GUEST_ENV="$GUEST_ENV TERM=${TERM:-xterm}"
	vt_log "shell mode: dropping into an interactive root shell in the guest"
	vt_log "  exit the shell (or Ctrl-D) to power off the VM"
fi

# Networking.
#   VMTEST_NET    user-mode (SLIRP) networking, ON BY DEFAULT: the guest gets
#                 a DHCP address and can reach host services at the gateway
#                 10.0.2.2 (a server bound on the host's 127.0.0.1:PORT is
#                 10.0.2.2:PORT from inside the guest). No host setup or root
#                 required. Set VMTEST_NET=0 to disable for a hermetic boot.
#   VMTEST_NET2   second user-mode interface, OFF BY DEFAULT. Set to any
#                 non-empty, non-zero value to add an extra --network user
#                 (guest sees eth0 + eth1 on distinct subnets).
#   VMTEST_SSH=1  in-VM sshd so `vng --ssh-client` can attach; this needs
#                 networking, so it forces user-mode on even if VMTEST_NET=0.
# --network user is added once per enabled network interface (VMTEST_NET +
# optionally VMTEST_NET2). VMTEST_SSH forces the first on regardless.
: "${VMTEST_NET:=1}"
NET_ARGS=()
# VMTEST_NET is default-on, so unlike the opt-in VMTEST_SSH/VMTEST_HOLD knobs
# (plain non-empty test) it treats `0` and empty as off and any other value
# as on. VMTEST_SSH forces networking on regardless.
if { [ -n "$VMTEST_NET" ] && [ "$VMTEST_NET" != 0 ]; } || [ -n "${VMTEST_SSH:-}" ]; then
	NET_ARGS+=(--network user)
	vt_log "user-mode networking on: reach host services at 10.0.2.2 (VMTEST_NET=0 to disable)"
	# VMTEST_NET2 adds a second user-mode interface (off by default).
	if [ -n "${VMTEST_NET2:-}" ] && [ "$VMTEST_NET2" != 0 ]; then
		NET_ARGS+=(--network user)
		vt_log "VMTEST_NET2: adding second user-mode network interface"
	fi
fi
if [ -n "${VMTEST_SSH:-}" ]; then
	NET_ARGS+=(--ssh --ssh-tcp)
	vt_log "VMTEST_SSH=1: enabling in-VM sshd"
	vt_log "  attach with: $VNG_BIN --ssh-client --ssh-tcp"
	vt_log "  (run from another terminal; --ssh-tcp must match on both sides)"
fi

# Build a guest PATH that includes any cargo-installed bin dirs present
# on the host. /home is exposed read-write into the guest via overlay,
# so paths like /home/<user>/.cargo/bin resolve at the same absolute
# location inside the VM. The glob expands here (on the host) before
# vng is invoked; missing directories are filtered out.
GUEST_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
for d in /home/*/.cargo/bin /root/.cargo/bin; do
	[ -d "$d" ] && GUEST_PATH="$d:$GUEST_PATH"
done

# --- confidentiality mask (VMTEST_MASK=0 to disable) -----------------------
# The guest rootfs is the HOST filesystem over 9p, served by qemu with the
# invoking user's credentials — including $HOME/.ssh (private keys!). Launch
# the vng/qemu chain inside an unprivileged user+mount namespace where
# $HOME/.ssh is overmounted with an empty directory, so the 9p server cannot
# serve the real one (this also holds against guest-side remounts — the mask
# lives on the host side of 9p). Deliberately MINIMAL: only .ssh is masked;
# /etc root-only secrets (shadow, sudoers, key material) are unreadable
# through 9p anyway since qemu runs with this user's credentials.
MASK_WRAP=()
# No mask in interactive shell mode: vng starts the shell through the guest's
# su BEFORE the prelude can run its nosuid pass, and under the mask su is
# setuid-nobody ("su: cannot set groups"). Shell mode is the user at the
# console, not unattended test code, so run it unmasked — byte-for-byte the
# pre-mask behavior.
if [ "${VMTEST_MASK:-1}" = 1 ] && [ -z "$SHELL_MODE" ]; then
	if unshare --map-root-user --mount true 2>/dev/null && [ -d "$HOME/.ssh" ]; then
		MASK_EMPTY_DIR="$VMTEST_TMPDIR/vmtest-empty.d"
		mkdir -p "$MASK_EMPTY_DIR"
		export VMTEST_MASK_EMPTY_DIR="$MASK_EMPTY_DIR"
		VMTEST_MASK_UID="$(id -u)"
		VMTEST_MASK_GID="$(id -g)"
		export VMTEST_MASK_UID VMTEST_MASK_GID
		# Nested namespaces: the OUTER map-root-user pass does the bind
		# (mount(8) refuses with a non-zero euid), then the INNER unshare
		# maps back to the invoking uid/gid before exec'ing vng — so qemu
		# and the guest see exactly the uid view of an unmasked run (a
		# fake-root euid confuses vng and breaks guest mounts).
		# shellcheck disable=SC2016  # the inner script expands in the namespace
		MASK_WRAP=(unshare --map-root-user --mount bash -c '
			set -e
			mount --bind "$VMTEST_MASK_EMPTY_DIR" "$HOME/.ssh"
			exec unshare --map-user="$VMTEST_MASK_UID" \
				--map-group="$VMTEST_MASK_GID" "$@"' vmtest-mask)
		vt_log "mask: \$HOME/.ssh hidden from the guest (VMTEST_MASK=0 disables)"
	else
		vt_log "VMTEST_MASK: user namespaces unavailable (or no ~/.ssh); running unmasked"
	fi
fi

# Guest prelude: normalize the guest before the test (or shell) runs.
#
# 1) With VMTEST_MASK, qemu runs in an unprivileged user namespace where
#    host-root-owned files appear as nobody over 9p — including the SETUID
#    bits on mount/umount/su, which then switch to euid nobody and refuse to
#    work ("mount: must be superuser"). Remount every guest mount nosuid via
#    raw mount(2) (python, since mount(8) is one of the broken tools): setuid
#    bits are then ignored and the tools run with the caller's identity —
#    always root in this guest. Tests needing real setuid semantics use the
#    TEST/SCRATCH devices, whose fresh mounts stay suid-capable.
#
# 2) virtme-ng-init bind-mounts generated config FILES (fstab, hosts, shadow,
#    sudoers, resolv.conf stubs) over the guest /etc; tools that walk the
#    mount table choke on a file mountpoint — the quota tools spew
#    "repquota: Unable to get a filedescriptor from mountpoint: /etc/fstab",
#    polluting six xfstests quota tests' golden output. Replace each file
#    bind-mount with a plain copy of the SAME content in the overlay upper,
#    then unmount (looping for stacked binds).
#
# 3) The guest env advertises XDG_RUNTIME_DIR but its creation depends on
#    boot details; tests bind sockets under it, so guarantee it exists.
GUEST_PRELUDE="$VMTEST_TMPDIR/vmtest-prelude.sh"
# The nosuid pass is ONLY needed (and only applied) when the mask is active:
# without the user namespace, setuid binaries work normally and the guest
# should stay byte-for-byte identical to the pre-mask world.
if [ ${#MASK_WRAP[@]} -gt 0 ]; then MASK_ON=1; else MASK_ON=0; fi
cat > "$GUEST_PRELUDE" <<PRELUDE
#!/bin/bash
# Generated by run_vm; runs as root inside the guest before the test.
export VMTEST_MASK_ON=$MASK_ON
PRELUDE
cat >> "$GUEST_PRELUDE" <<'PRELUDE'
[ -n "${XDG_RUNTIME_DIR:-}" ] && mkdir -p "$XDG_RUNTIME_DIR"
python3 - <<'PY'
import ctypes, os, shutil

libc = ctypes.CDLL("libc.so.6", use_errno=True)
MS_RDONLY, MS_NOSUID, MS_NODEV, MS_NOEXEC = 0x1, 0x2, 0x4, 0x8
MS_NOATIME, MS_NODIRATIME, MS_RELATIME = 0x400, 0x800, 0x200000
MS_REMOUNT, MS_BIND = 0x20, 0x1000
OPT = {"ro": MS_RDONLY, "nosuid": MS_NOSUID, "nodev": MS_NODEV,
       "noexec": MS_NOEXEC, "noatime": MS_NOATIME,
       "nodiratime": MS_NODIRATIME, "relatime": MS_RELATIME}

def mounts():
    out = []
    with open("/proc/self/mounts", "rb") as f:
        for line in f:
            parts = line.split()
            if len(parts) >= 4 and parts[1].startswith(b"/"):
                mnt = parts[1].decode("unicode_escape")
                opts = parts[3].decode()
                out.append((mnt, opts))
    return out

# (2) file bind-mounts -> same-content plain copies.
for mnt, _ in sorted(set(mounts())):
    if not os.path.isfile(mnt):
        continue
    tmp = mnt + ".vmtest-tmp"
    try:
        shutil.copyfile(mnt, tmp)
    except OSError:
        continue
    while libc.umount2(mnt.encode(), 0) == 0:
        pass
    try:
        os.replace(tmp, mnt)
    except OSError:
        os.unlink(tmp)

# (1) nosuid everywhere, preserving each mount's existing flags — but only
# under the mask, where the user namespace turns setuid-root binaries into
# setuid-nobody ones over 9p.
if os.environ.get("VMTEST_MASK_ON") == "1":
    for mnt, opts in mounts():
        flags = MS_REMOUNT | MS_BIND | MS_NOSUID
        for o in opts.split(","):
            flags |= OPT.get(o, 0)
        libc.mount(b"none", mnt.encode(), None, flags, None)
PY
PRELUDE
chmod +x "$GUEST_PRELUDE"

# Mode-specific vng args. Test mode runs the script via --exec, prefixing
# the env that vng does not otherwise forward. Shell mode instead boots
# interactively (so the getty owns the console for bidirectional I/O) and
# carries the same env through a generated wrapper passed to --shell. The
# wrapper lives under VMTEST_TMPDIR, which is mounted into the guest at the
# same absolute path, so vng can exec it as the login shell.
MODE_ARGS=()
if [ -n "$SHELL_MODE" ]; then
	SHELL_WRAPPER="$VMTEST_TMPDIR/vmtest-shell.sh"
	{
		echo '#!/bin/bash'
		# printf %q shell-quotes each value so quotes/spaces/metacharacters
		# in a forwarded path can't break or inject into the wrapper.
		printf 'export PATH=%q\n' "$GUEST_PATH"
		for kv in $GUEST_ENV; do
			printf 'export %s=%q\n' "${kv%%=*}" "${kv#*=}"
		done
		printf 'bash %q\n' "$GUEST_PRELUDE"
		printf 'cd %q 2>/dev/null || true\n' "$SELF_DIR"
		echo 'exec bash -i'
	} > "$SHELL_WRAPPER"
	chmod +x "$SHELL_WRAPPER"
	MODE_ARGS=(--shell "$SHELL_WRAPPER")
else
	MODE_ARGS=(--exec "bash $GUEST_PRELUDE; env PATH=$GUEST_PATH $GUEST_ENV $TEST_CMD $*")
fi


# shellcheck disable=SC2086
"${MASK_WRAP[@]}" "$VNG_BIN" "${RUN_ARGS[@]}" --force-9p \
	--cpus "$VM_CPUS" --memory "$VM_MEM" \
	--verbose \
	--rwdir "$VMTEST_DATA_DIR" \
	--user root \
	"${NET_ARGS[@]}" \
	--append "$KCMDLINE" \
	"${MODE_ARGS[@]}" \
	"--qemu-opts=$QEMU_EXTRA"
